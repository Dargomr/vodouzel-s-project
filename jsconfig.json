{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ESNext",
    "jsx": "preserve",
    "checkJs": false,
    "allowJs": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "**/*.js",
    "**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
